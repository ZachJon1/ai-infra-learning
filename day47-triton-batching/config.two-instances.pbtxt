name: "toy_classifier"
backend: "onnxruntime"

max_batch_size: 8

input [
  {
    name: "INPUT"
    data_type: TYPE_FP32
    dims: [4]
  }
]

output [
  {
    name: "OUTPUT"
    data_type: TYPE_FP32
    dims: [2]
  }
]

version_policy: {
  latest: {
    num_versions: 2
  }
}

dynamic_batching {
  max_queue_delay_microseconds: 2000
}

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]